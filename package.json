{
  "name": "budgeted",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "next build",
    "check:ledger-integrity": "node ./scripts/check-ledger-integrity.mjs",
    "check:workspace-protocol": "node ./scripts/check-workspace-protocol.mjs",
    "check:workspace-state": "node ./scripts/check-workspace-state.mjs",
    "cutover:workspace-sync-v2": "node ./scripts/cutover-workspace-sync-v2.mjs",
    "dev": "node ./scripts/dev-sst.mjs",
    "deploy": "sst deploy --stage production",
    "prod": "pnpm run deploy",
    "dev:turbo": "node ./scripts/dev-turbo.mjs",
    "dev:webpack": "node ./scripts/dev-safe.mjs",
    "hooks:install": "node ./scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "migrate:transaction-importers": "node ./scripts/migrate-transaction-importers.mjs",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "purge:workspace-changes": "node ./scripts/purge-workspace-changes.mjs",
    "release": "tsx ./scripts/release.ts",
    "reset:db": "node ./scripts/reset-database.mjs",
    "repair:workspace-state": "node ./scripts/repair-workspace-state.mjs",
    "seed:user": "node ./scripts/seed-user.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "node ./scripts/test-e2e.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.57",
    "@aws-sdk/client-dynamodb": "^3.1125.0",
    "@aws-sdk/client-lambda": "^3.1125.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/lib-dynamodb": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@noble/hashes": "2.4.0",
    "ai": "^7.0.91",
    "csv-parse": "^7.0.2",
    "downshift": "^9.4.0",
    "electrodb": "^3.9.3",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "idb": "^8.0.3",
    "mathjs": "^15.2.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.31",
    "plaid": "^47.0.0",
    "postal-mime": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "smol-toml": "^1.8.0",
    "sst": "^4.17.1",
    "ulid": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/aws-lambda": "^8.10.163",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
